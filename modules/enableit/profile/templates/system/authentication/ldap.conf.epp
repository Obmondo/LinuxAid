# Managed by Puppet
#
# See ldap.conf(5) for details
# This file should be world readable but not world writable.

URI <%= $uri %>
BASE <%= $base %>
TLS_CACERT <%= $tls_cacert %>
<%# NOTE: do not set `sasl_secprops maxssf=0` here. It disables SASL integrity
# (signing) for every libldap client, incl. adcli, realm and sssd, and an AD that
# enforces LDAP signing then rejects the bind with:
# 00002028: LdapErr: DSID-0C090360, comment: The server requires binds to turn on
# integrity checking if SSL\TLS are not already active on the connection
-%>
# Turning this off breaks GSSAPI used with krb5 when rdns = false
SASL_NOCANON on
