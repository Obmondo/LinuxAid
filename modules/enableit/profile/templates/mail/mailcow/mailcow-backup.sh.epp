<%- |
  Stdlib::Absolutepath $install_dir,
  Stdlib::Absolutepath $backup_dir,
  Integer[1]           $local_keep_days,
  Optional[String]     $restic_repository,
  Stdlib::Absolutepath $restic_env_file,
  String               $restic_image,
  String               $restic_host,
  Integer[1]           $keep_daily,
  Integer[0]           $keep_weekly,
| -%>
#!/bin/bash
# THIS FILE IS MANAGED BY LINUXAID. CHANGES WILL BE LOST.
#
# Runs mailcow's own backup, checks the result and copies it offsite with
# restic.
set -euo pipefail

INSTALL_DIR='<%= $install_dir %>'
BACKUP_DIR='<%= $backup_dir %>'
LOCAL_KEEP_DAYS=<%= $local_keep_days %>
# Empty when no offsite copy is configured.
RESTIC_REPOSITORY='<%= $restic_repository %>'
RESTIC_ENV_FILE='<%= $restic_env_file %>'
RESTIC_IMAGE='<%= $restic_image %>'
RESTIC_HOST='<%= $restic_host %>'
KEEP_DAILY=<%= $keep_daily %>
KEEP_WEEKLY=<%= $keep_weekly %>
RESTIC_CACHE=/var/cache/mailcow-backup-restic
METRICS_DIR=/var/lib/node_exporter/textfile_collector
LOCK_FILE=/run/mailcow-backup.lock

# Without these a backup cannot be restored: vmail holds the mail, crypt the
# key the mail is encrypted with, mariadb the mailboxes and aliases.
REQUIRED_FILES=(mailcow.conf backup_vmail.tar.zst backup_crypt.tar.zst backup_mariadb.tar.zst)

# Under systemd stdout already lands in the journal; logger only for runs by
# hand, or every line is logged twice.
log() {
  echo "[$(date +'%Y-%m-%d %H:%M:%S')] $1"
  [ -n "${INVOCATION_ID:-}" ] || logger -t mailcow-backup "$1"
}

# node_exporter picks these up, so a backup that silently stops running shows
# up as a stale timestamp instead of going unnoticed.
write_metric() {
  local name=$1 value=$2 tmp
  [ -d "$METRICS_DIR" ] || return 0
  tmp=$(mktemp "$METRICS_DIR/.mailcow_backup.XXXXXX")
  {
    [ -f "$METRICS_DIR/mailcow_backup.prom" ] && grep -v "^${name} " "$METRICS_DIR/mailcow_backup.prom" || true
    echo "${name} ${value}"
  } > "$tmp"
  chmod 0644 "$tmp"
  mv "$tmp" "$METRICS_DIR/mailcow_backup.prom"
}

# Empty when there is no backup yet, which must not trip set -e/pipefail.
latest_local_backup() {
  find "$BACKUP_DIR" -mindepth 1 -maxdepth 1 -type d -name 'mailcow-*' 2>/dev/null | sort | tail -n 1 || true
}

# mailcow's tar runs with -v and prints every mail file it archives, which
# would put hundreds of thousands of lines into the journal each night. Its
# stdout goes to a file kept for the last run only; errors stay on stderr.
UPSTREAM_LOG=/var/log/mailcow-backup-upstream.log

run_backup() {
  log "Running mailcow backup into $BACKUP_DIR (file list in $UPSTREAM_LOG)"
  BACKUP_LOCATION="$BACKUP_DIR" CREATE_BACKUP_LOCATION=yes \
    "$INSTALL_DIR/helper-scripts/backup_and_restore.sh" backup all --delete-days "$LOCAL_KEEP_DAYS" \
    > "$UPSTREAM_LOG"
}

# A truncated or empty backup is still a directory full of files. Check it
# before it is copied offsite.
verify_backup() {
  local dir=$1 prev=$2 f size prev_size

  for f in "${REQUIRED_FILES[@]}"; do
    if [ ! -s "$dir/$f" ]; then
      log "Error: $dir/$f is missing or empty."
      return 1
    fi
  done

  # Mail only grows slowly, so a vmail archive under half the previous one
  # means the backup broke off.
  if [ -n "$prev" ] && [ -s "$prev/backup_vmail.tar.zst" ]; then
    size=$(stat -c %s "$dir/backup_vmail.tar.zst")
    prev_size=$(stat -c %s "$prev/backup_vmail.tar.zst")
    if [ "$size" -lt "$(( prev_size / 2 ))" ]; then
      log "Error: vmail archive is ${size} bytes, less than half the previous ${prev_size} bytes."
      return 1
    fi
  fi

  for f in "$dir"/*.tar.zst; do
    if ! zstd -q -t "$f"; then
      log "Error: $f failed the zstd integrity check."
      return 1
    fi
  done

  log "Backup $(basename "$dir") verified."
}

# restic from a pinned image, so the host needs no package for it. The
# backup is always mounted at /mailcow, so restic finds the previous snapshot
# as its parent; mailcow builds the archives with zstd --rsyncable, so only the
# chunks that changed since then are uploaded.
restic() {
  local mounts=()
  [ -n "${RESTIC_SRC:-}" ] && mounts=(-v "$RESTIC_SRC:/mailcow:ro")
  docker run --rm -i --network host \
    --env-file "$RESTIC_ENV_FILE" \
    -e RESTIC_REPOSITORY="$RESTIC_REPOSITORY" \
    -e RESTIC_CACHE_DIR=/cache \
    -v "$RESTIC_CACHE:/cache" \
    "${mounts[@]}" \
    "$RESTIC_IMAGE" "$@"
}

offsite_copy() {
  local dir=$1 name
  name=$(basename "$dir")
  mkdir -p "$RESTIC_CACHE"

  # restic exits 10 when the repository does not exist and 12 on a wrong
  # password. Only the first may create it; anything else is an error.
  local rc=0
  restic cat config >/dev/null 2>&1 || rc=$?
  case "$rc" in
    0) ;;
    10)
      log "Initialising restic repository $RESTIC_REPOSITORY"
      restic init || return 1
      ;;
    12) log "Error: wrong password for restic repository $RESTIC_REPOSITORY."; return 1 ;;
    *)  log "Error: cannot open restic repository $RESTIC_REPOSITORY (restic exit $rc)."; return 1 ;;
  esac

  # A run that was killed leaves a lock behind; unlock only removes stale ones.
  restic unlock >/dev/null 2>&1 || true

  log "Copying $name offsite to $RESTIC_REPOSITORY"
  RESTIC_SRC=$dir restic backup --host "$RESTIC_HOST" --tag mailcow --tag "$name" /mailcow || return 1

  log "Removing offsite snapshots beyond ${KEEP_DAILY} daily and ${KEEP_WEEKLY} weekly"
  restic forget --host "$RESTIC_HOST" --tag mailcow \
    --keep-daily "$KEEP_DAILY" --keep-weekly "$KEEP_WEEKLY" --prune || return 1

  restic check || return 1
  log "Offsite copy of $name complete."
}

exec 9>"$LOCK_FILE"
if ! flock -n 9; then
  log "Another mailcow-backup run is in progress, exiting."
  exit 0
fi

rc=0
before=$(latest_local_backup)
run_backup || log "backup_and_restore.sh exited non-zero, checking what it left."
new=$(latest_local_backup)

if [ -z "$new" ] || [ "$new" = "$before" ]; then
  log "Error: no new backup directory was created in $BACKUP_DIR."
  rc=1
elif ! verify_backup "$new" "$before"; then
  rc=1
else
  write_metric mailcow_backup_local_last_success_timestamp_seconds "$(date +%s)"
  write_metric mailcow_backup_local_last_size_bytes "$(du -sb "$new" | cut -f1)"

  if [ -n "$RESTIC_REPOSITORY" ]; then
    if offsite_copy "$new"; then
      write_metric mailcow_backup_offsite_last_success_timestamp_seconds "$(date +%s)"
    else
      log "Error: offsite copy of $(basename "$new") failed."
      rc=1
    fi
  fi
fi

write_metric mailcow_backup_last_run_success "$(( rc == 0 ? 1 : 0 ))"
if [ "$rc" -ne 0 ]; then
  log "Backup finished with errors."
else
  log "Backup finished."
fi
exit "$rc"
