<%- | String               $description,
      Stdlib::Absolutepath $exec_start,
| -%>
# MANAGED BY PUPPET; CAVEAT LECTOR

[Unit]
Description=<%= $description %>
After=network-online.target
Wants=network-online.target

[Service]
Type=forking
Restart=always
TimeoutSec=30s
ExecStart=<%= $exec_start %>

[Install]
WantedBy=multi-user.target
