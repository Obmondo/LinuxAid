services:
  rustfs:
    image: <%= $image %>:<%= $version %>
    restart: always
    volumes:
      - <%= $data_dir %>:/data
    environment:
<%- $env_vars.each |$key, $value| { -%>
      <%= $key %>: '<%= $value %>'
<%- } -%>
    ports:
      - <%= $listen_address %>:9000:9000
      - <%= $listen_address %>:9001:9001
